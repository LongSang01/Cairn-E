# Rendered at container start by /docker-entrypoint.d/40-cairn-auth.sh:
# __CAIRN_REALM__ comes from web.auth.realm in dispatch.yaml, and the two
# auth_basic lines are dropped entirely when web.auth is absent.

server {
    listen 80;
    server_name _;

    auth_basic "__CAIRN_REALM__";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # SSE session streams must pass through unbuffered; the read timeout must
    # exceed the server's 300s stream idle limit.
    proxy_buffering off;
    proxy_read_timeout 360s;
    proxy_send_timeout 360s;

    location / {
        proxy_pass http://cairn-server:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Marks this request as coming through the authenticated UI. Endpoints that can
        # weaken the command guard (write rules, decide approvals, edit scope) require
        # it; the worker channel never receives this header.
        proxy_set_header X-Cairn-UI-Token "__CAIRN_UI_TOKEN__";
    }
}
